# Postgres
POSTGRES_USER=stonemachine
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stonemachine
DATABASE_URL=postgresql://stonemachine:change-me@localhost:5432/stonemachine

# Секрет подписи сессий админки (openssl rand -hex 32)
SESSION_SECRET=change-me-to-64-hex-chars

# Куда складываются загруженные фото
UPLOAD_DIR=./data/uploads

# Публичный адрес сайта (для OG-тегов). На голом IP: http://1.2.3.4
SITE_URL=http://localhost:3000

# Куки только по HTTPS. На голом IP без сертификата — false
COOKIE_SECURE=false
